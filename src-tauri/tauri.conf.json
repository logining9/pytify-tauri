{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pytify-tauri",
  "version": "0.1.0",
  "identifier": "com.sergo.pytify-tauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
  {
    "title": "pytify-tauri",
    "width": 1100,
    "height": 750,
    "resizable": true,
    "fullscreen": false,
    "devtools": true
  }
],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/deno"
    ],
    "resources": [
      "binaries/*"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
